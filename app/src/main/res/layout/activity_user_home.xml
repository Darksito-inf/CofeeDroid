<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background_coffee">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarUser"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/coffee_primary"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_client"
                android:textColor="@color/coffee_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/client_subtitle"
                android:textColor="@color/coffee_medium"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- SOBRE NUESTRO CAFÉ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_coffee_info"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/coffee_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coffee_info_description"
                        android:textSize="14sp"
                        android:textColor="@color/coffee_text_secondary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- MENÚ DE CAFÉS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_coffee_menu"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/coffee_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coffee_menu_list"
                        android:textSize="14sp"
                        android:textColor="@color/coffee_text_secondary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PROMOCIONES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/promotions_title"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/coffee_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/promotions_list"
                        android:textSize="14sp"
                        android:textColor="@color/coffee_text_secondary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECCIÓN PEDIDOS: se hace el pedido aquí mismo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_pedidos_section"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/coffee_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_cafe"
                        android:textStyle="bold"
                        android:textColor="@color/coffee_primary"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerCafeUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_tipo_pedido"
                        android:textStyle="bold"
                        android:textColor="@color/coffee_primary"
                        android:layout_marginBottom="4dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupTipoPedidoUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <RadioButton
                            android:id="@+id/radioLlevarUser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_llevar"
                            android:checked="true"
                            android:layout_marginEnd="24dp" />

                        <RadioButton
                            android:id="@+id/radioMesaUser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_mesa" />
                    </RadioGroup>

                    <Spinner
                        android:id="@+id/spinnerMesaUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnRealizarPedido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_realizar_pedido"
                        android:backgroundTint="@color/coffee_secondary"
                        android:textColor="@color/white"
                        android:minHeight="48dp"
                        android:layout_marginBottom="20dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ordenes_actuales"
                        android:textStyle="bold"
                        android:textColor="@color/coffee_primary"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/listaPedidosUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>